#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PORT="8008"
URL="http://localhost:${PORT}"
DIST_INDEX="$ROOT_DIR/dist/index.html"

cd "$ROOT_DIR"

is_up() {
  curl -fsS "$URL" >/dev/null 2>&1
}

needs_build() {
  if [[ ! -f "$DIST_INDEX" ]]; then
    return 0
  fi

  if find "$ROOT_DIR/src" -type f -newer "$DIST_INDEX" -print -quit | grep -q .; then
    return 0
  fi

  if find "$ROOT_DIR" -maxdepth 1 -type f \( -name "package.json" -o -name "vite.config.js" -o -name "index.html" \) -newer "$DIST_INDEX" -print -quit | grep -q .; then
    return 0
  fi

  return 1
}

if needs_build; then
  echo "UI build is missing or stale. Building frontend ..."
  npm run build
fi

if ! is_up; then
  echo "Starting npm localserver on ${URL} ..."
  npm run localserver >/tmp/vault-localserver.log 2>&1 &

  for _ in {1..30}; do
    if is_up; then
      break
    fi
    sleep 1
  done
fi

if ! is_up; then
  echo "Local server did not come up on ${URL}."
  echo "See /tmp/vault-localserver.log for details."
  exit 1
fi

echo "Local server is running on ${URL}"

# Open in GBrowser via IDEA's built-in REST API (triggers GBrowserHomeAction).
# One-time setup required: Settings → Tools → GBrowser → set Homepage to http://localhost:8008
curl -sf "http://localhost:63342/api/action/GBrowserHomeAction" >/dev/null 2>&1 || true

echo "If GBrowser did not open automatically:"
echo "1) In IntelliJ IDEA: View → Tool Windows → GBrowser"
echo "2) Navigate to ${URL}"
