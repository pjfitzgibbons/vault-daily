{
  "name": "vault-daily",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node src/server.cjs",
    "dev": "concurrently \"node src/server.cjs\" \"vite\"",
    "build": "vite build",
    "localserver": "PORT=8008 node src/server.cjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "npx --yes playwright test tests/e2e/*.spec.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "concurrently": "^8.2.2",
    "playwright": "^1.61.0",
    "vite": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "pino": "^10.3.1",
    "vue": "^3.4.0"
  }
}
