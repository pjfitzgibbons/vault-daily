{
  "name": "vault-daily",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"node server.js\" \"npm run dev --prefix daily-ui\"",
    "build": "npm run build --prefix daily-ui",
    "localserver": "PORT=8008 node server.js",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "npx playwright test tests/e2e/day-routing.spec.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "pino": "^10.3.1"
  }
}
